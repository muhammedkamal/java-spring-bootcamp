            "description": "Create. JSONPlaceholder fakes it: you get id 101 back, but nothing is saved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hello REST\",\n  \"body\": \"My first POST\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
