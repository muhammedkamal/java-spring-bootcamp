        {
          "name": "GET /books (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns two books\", () => pm.expect(pm.response.json()).to.have.length(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{localBase}}/books",
              "host": [
                "{{localBase}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Read the list. Look at the Content-Type header in the response."
