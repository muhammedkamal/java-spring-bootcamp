    {
      "name": "2. JSONPlaceholder (public)",
      "description": "https://jsonplaceholder.typicode.com: a free fake REST API.",
      "item": [
        {
          "name": "GET /posts (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"100 posts\", () => pm.expect(pm.response.json()).to.have.length(100));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{publicBase}}/posts",
              "host": [
                "{{publicBase}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "A collection: 100 posts."
          }
        },
        {
          "name": "GET /posts/1 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"id is 1\", () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{publicBase}}/posts/1",
              "host": [
                "{{publicBase}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "description": "One item: the id is in the path."
          }
        },
        {
          "name": "GET /posts?userId=1 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"all from user 1\", () => pm.response.json().forEach(p => pm.expect(p.userId).to.eql(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{publicBase}}/posts?userId=1",
              "host": [
                "{{publicBase}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            },
            "description": "Filter: filters go in the query string."
          }
        },
        {
          "name": "GET /posts/1/comments (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
