            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{publicBase}}/posts/1/comments",
              "host": [
                "{{publicBase}}"
              ],
              "path": [
                "posts",
                "1",
                "comments"
              ]
            },
            "description": "A nested resource: the comments of post 1."
          }
        },
        {
          "name": "POST /posts (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"new id returned\", () => pm.expect(pm.response.json().id).to.eql(101));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
